[Unit]
Description=Home Trainer Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/home-trainer-bot
ExecStart=/home/ubuntu/home-trainer-bot/.venv/bin/python bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
